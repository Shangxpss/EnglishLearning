{
  "name": "english-learning-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:web\" \"pnpm run dev:backend\"",
    "dev:web": "pnpm --filter=web dev",
    "dev:mobile": "pnpm --filter=mobile dev",
    "dev:backend": "cd backend && uv run --active uvicorn app.main:app --reload --host 0.0.0.0 --port 8004",
    "build": "pnpm --filter=web build",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f",
    "setup": "pnpm install && cd backend && uv sync && cd .. && docker-compose up -d",
    "clean": "rm -rf frontend/*/node_modules backend/.venv node_modules"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
